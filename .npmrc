# @nestjs/swagger@11.4.6's peer range (^11.0.1) conflicts with this project's actual
# @nestjs/common/@nestjs/core@^10.4.x — the rest of the stack is intentionally on Nest v10.
# In practice the Swagger module boots and serves /docs fine against Nest v10 here; the
# peer range is just stricter than what's actually required. Without this, `npm ci`
# (used by Docker builds, CI, and any fresh clone) fails with ERESOLVE — this file makes
# the already-working local resolution reproducible everywhere instead of accidental.
legacy-peer-deps=true
