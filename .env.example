# Server Configuration
PORT=8080
NODE_ENV=development

# MySQL Database URL
DATABASE_URL=mysql://username:password@localhost:3306/nexin_whitelabel_db

# JWT Authentication Secrets
JWT_SECRET_KEY=your_jwt_secret_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
QRPAYCHARGE_WEBHOOK_SECRET=

# AWS S3 & CloudFront Storage
AWS_REGION=ap-south-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
CLOUDFRONT_DOMAIN=

# Mail & Notification Config
AWS_SES_FROM_EMAIL=support@nexinev.com
EMAIL_HOST=smtp.gmail.com

# Firebase FCM
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# OCPI Protocol Config
OCPI_SERVER=http://localhost:8080
CURR_OCPI_VERSION=2.2.1
OCPI_SESSION_CURRENCY=INR
EMSP_MAX_AMOUNT=1000

# System Base URL
BASE_URL=http://localhost:8080/uploads
