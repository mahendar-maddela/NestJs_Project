{
  "name": "nexin-enterprise-application",
  "version": "1.0.0",
  "description": "Nexin Enterprise Application",
  "author": "Nexin",
  "license": "proprietary",
  "private": true,
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\" \"modules/**/*.ts\" \"integrations/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "build:all": "nest build api && nest build ocpp-gateway && nest build scheduler",
    "start:prod": "node dist/apps/api/apps/api/src/main.js",
    "start:gateway": "nest start ocpp-gateway --watch",
    "start:gateway:prod": "node dist/apps/ocpp-gateway/apps/ocpp-gateway/src/main.js",
    "start:scheduler": "nest start scheduler --watch",
    "start:scheduler:prod": "node dist/apps/scheduler/apps/scheduler/src/main.js",
    "typeorm:cli": "typeorm-ts-node-commonjs -d database/src/data-source.ts",
    "typeorm:migration:generate": "typeorm-ts-node-commonjs migration:generate -d database/src/data-source.ts",
    "typeorm:migration:run": "typeorm-ts-node-commonjs migration:run -d database/src/data-source.ts",
    "seed": "ts-node -r tsconfig-paths/register database/src/seeds/seed.ts",
    "lint": "eslint \"{src,apps,libs,modules,integrations}/**/*.ts\" --fix",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1105.0",
    "@aws-sdk/client-ses": "^3.1104.0",
    "@aws-sdk/cloudfront-signer": "^3.1111.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^8.3.0",
    "@fastify/static": "^7.0.4",
    "@fastify/swagger": "^9.8.1",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.4",
    "@nestjs/platform-fastify": "^10.4.15",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/typeorm": "^11.0.3",
    "@types/uuid": "^10.0.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.41.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dayjs": "^1.11.21",
    "fastify": "^4.28.1",
    "fastify-raw-body": "^4.3.0",
    "firebase-admin": "^14.2.0",
    "ioredis": "^5.5.0",
    "mysql2": "^3.23.2",
    "nestjs-cls": "^4.5.0",
    "nestjs-pino": "^4.3.0",
    "nodemailer": "^9.0.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.0.0",
    "puppeteer": "^25.6.0",
    "razorpay": "^2.9.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "typeorm": "^1.1.0",
    "uuid": "^14.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.13.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/ws": "^8.5.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
